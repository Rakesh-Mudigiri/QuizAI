# ==============================================================================
# QuizAI Production Deployment Environment Variables
# ==============================================================================

# Groq Cloud API Key (Get free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_BACKUP=optional_backup_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Database URL
# For SQLite (local / default):
DATABASE_URL=sqlite:///./quiz_generator.db
# For Cloud MySQL / TiDB (optional production database):
# DATABASE_URL=mysql+pymysql://username:password@host:4000/database_name?ssl_verify_cert=true

# Security & CORS (comma-separated origins or * for all)
ALLOWED_ORIGINS=*

# Server Port
PORT=8000
